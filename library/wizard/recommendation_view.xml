<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_book_recommendation_wizard" model="ir.actions.act_window">
        <field name="name">Recommendation for Books</field>
        <field name="res_model">book.recommendation</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_book_recommendation"/>
        <field name="binding_view_types">list,form</field>
    </record>
    <record id="view_recommend_wizard" model="ir.ui.view">
        <field name="name">book.recommendation.form</field>
        <field name="model">book.recommendation</field>
        <field name="arch" type="xml">
            <form string="Recommend Books">
                <group>
                    <field name="recommendation_ids"/>
                </group>
                            <footer>
                                <button string="Confirm" type="object" name="action_recommend_confirm"/>
                            </footer>
            </form>
        </field>
    </record>

</odoo>