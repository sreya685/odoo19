<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--Form View For Wizard-->
    <record id="xlsx_report_wizard_view_form" model="ir.ui.view">
        <field name="name">xlsx.report.wizard.view.form</field>
        <field name="model">xlsx.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Book Borrow XLSX Report">
                  <group>
                <group>
                    <field name="mem_id"/>
                </group>

                </group>
                <group>
                <group>
                    <field name="book_name"/>
                </group>
                <group>
                    <field name="author_name"/>
                </group>
                </group>
                <group>
                <group>
                    <field name="checkout_date"/>
                </group>
                <group>
                    <field name="return_date"/>
                </group>
                </group>
                <group>
                    <field name="genres_type"/>
                </group>
                <group>
                    <field name="sort_by"/>
                </group>
                <group>
                    <field name="order" invisible="sort_by not in ['checkout_date','return_date'] "/>
                </group>
                <footer>
                    <button name="action_print_xlsx" string="Print"
                            type="object" class="btn-primary"/>
                    <button string="CANCEL" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <!-- Action -->
    <record id="xlsx_report_wizard_action"
            model="ir.actions.act_window">
        <field name="name">Book borrow XLSX Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">xlsx.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="xlsx_report_wizard_view_form"/>
        <field name="target">new</field>
    </record>

</odoo>

