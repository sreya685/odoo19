<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

   <record id="cron_overdue_reminder" model="ir.cron">
       <field name="name">Overdue Reminder</field>
       <field name="model_id" ref="model_checkouts"/>
       <field name="state">code</field>
       <field name="code">model.send_notification()</field>
       <field name="interval_number">1</field>
       <field name="interval_type">days</field>
       <field name="active" eval="True"/>
       <field name="nextcall">2026-01-03 17:00:00</field>
   </record>


</odoo>