<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
         <record id="module_category_library" model="ir.module.category">
            <field name="name">Library</field>
            <field name="sequence">103</field>
        </record>
       <record model="res.groups.privilege" id="res_groups_privilege_library">
            <field name="name">Library</field>
            <field name="sequence">13</field>
            <field name="category_id" ref="module_category_library"/>


        </record>
        <record id="library_group_user" model="res.groups">
            <field name="name">library Assistant</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_library"/>
            <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>


        </record>
        <record id="library_group_manager" model="res.groups">
            <field name="name">Librarian</field>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('library.library_group_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_library"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>

       <data noupdate="1">
        <record id="rule_library_assistant" model="ir.rule">
            <field name="name">Library Assistant can see only checkouts created by them</field>
            <field name="model_id" ref="model_checkouts"/>
            <field name="groups" eval="[4,(ref('library.library_group_user'))]"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
        </record>

       </data>
       <data noupdate="1">
             <record id="rule_librarian_new" model="ir.rule">
            <field name="name">Librarian can see all models</field>
            <field name="model_id" ref="model_checkouts"/>
            <field name="groups" eval="[(4, ref('library.library_group_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
       </data>

</odoo>