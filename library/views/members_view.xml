<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="members_action" model="ir.actions.act_window">
        <field name="name"> Members </field>
        <field name="res_model">members</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="members_view_list" model="ir.ui.view">
        <field name="name">members.list</field>
        <field name="model">members</field>
        <field name="arch" type="xml">
                <list string="members">
                        <field name="member_id"/>
                        <field name="maximum_book"/>
                </list>
        </field>
    </record>
    <record id="members_view_form" model="ir.ui.view">
        <field name="name">members.form</field>
        <field name="model">members</field>
        <field name="arch" type="xml">
            <form>


                <sheet>
                   <header>
                    <button name="action_checkouts_view"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-books">
                         <field name="checkout_count" widget="statinfo"> </field>

                    </button>
                   <button name="action_late_return_view"
                            type="object"
                            class="oe_stat_button">
                         <field name="total_late_returns" widget="statinfo"> </field>

                    </button>
                  <button name="action_total_penalties_view"
                            type="object"
                            class="oe_stat_button" clickable="False">
                         <field name="total_penalties" widget="statinfo" clickable="False"> </field>

                    </button>
                   </header>

                    <group>
                        <field name="member_id"/>
                    </group>
                    <group>
                        <field name="maximum_book"/>

                    </group>

                    <group>
                        <field name="maximum_books_in_single_checkout" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>