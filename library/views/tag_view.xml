<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="tags_action" model="ir.actions.act_window">
        <field name="name"> Tags </field>
        <field name="res_model">tags</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="tag_list_view" model="ir.ui.view">
        <field name="name">tags.list</field>
        <field name="model">tags</field>
        <field name="arch" type="xml">
            <list string="tags">
                <field name="tag_name" string="tag name"/>
            </list>
        </field>
    </record>

</odoo>