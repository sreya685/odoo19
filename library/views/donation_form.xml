<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="donation_form_template" name="Donation Form">
            <t t-call="website.layout">
                <section class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-md-6 col-lg-5">
                            <div class="card shadow rounded-3 border-0">
                                <div class="card-body p-4">
                                    <h3 class="mb-4 text-center">Donate Books</h3>
                                    <form action="/website/customer/create" method="post" enctype="multipart/form-data">
                                        <div class="mb-3">
                                            <label class="form-label">Book Name</label>
                                            <input type="text" name="book_name" required="required" class="form-control"/>
                                        </div>


                                          <input type="hidden" name="csrf_token"
                                                        t-att-value="request.csrf_token()"/>


                                        <div class="mb-3">
                                            <label class="form-label">Author Name</label>
                                            <input type="text" name="author_name" class="form-control"/>
                                        </div>





                                        <div>
                                               <label class="form-label">Condition</label>

                                                 <select name="condition" class="form-select">
                                                        <option value="new">New</option>
                                                        <option value="used" >Used</option>
                                               </select>
                                        </div>



                                               <div>

                                                       <input type="file" class="form-control-file"
                                                              id="attachment" name="attachment" multiple="multiple" required="1"/>
                                                   </div>




                                        <div class="mb-4">
                                            <label class="form-label">Book Description</label>
                                            <input type="text" name="description" class="form-control"/>
                                        </div>




                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <group>
                                        <group>

                                       <button type="submit" class="btn btn-primary">NEXT</button></group>
                                        <group>

                                              <button  class="btn btn-primary" special="cancel">RESET</button>
<!--                                             <button  special="cancel" class="btn btn-primary"/>-->
                                        </group>
                                    </group>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </t>
        </template>


        <template id="donation_success_template" name="Book Donation">
            <t t-call="website.layout">
                <div class="container">
                    <h3>Book Donation Done Successfully!</h3>
                </div>
            </t>
        </template>

        <record id="menu_donation_form" model="website.menu">
            <field name="name">Donation Form</field>
            <field name="url">/website/customer/form</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">60</field>
        </record>
    </data>
</odoo>
