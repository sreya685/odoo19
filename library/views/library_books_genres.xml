<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="genres_action" model="ir.actions.act_window">
        <field name="name"> Genres </field>
        <field name="res_model">genres</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="genres_view_form" model="ir.ui.view">
        <field name="name">genres.form</field>
        <field name="model">genres</field>
        <field name="arch" type="xml">
            <form>
            <sheet>
                <group>
                    <field name="genre_types"/>
                </group>
                <group>
                    <field name="description"/>
                </group>

            </sheet>
            </form>
        </field>
    </record>
    <record id="genres_view_list" model="ir.ui.view">
        <field name="name">genres.list</field>
        <field name="model">genres</field>
        <field name="arch" type="xml">
                <list string="genres">
                    <field name="genre_types"/>
                    <field name="description"/>


                </list>
        </field>
    </record>
    <record id="genres_view_search" model="ir.ui.view">
        <field name="name">genres.search</field>
        <field name="model">genres</field>
        <field name="arch" type="xml">
                <search string="genres">
                    <field name="genre_types"/>

                </search>
        </field>
    </record>
</odoo>