<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="authors_action" model="ir.actions.act_window">
        <field name="name"> Authors </field>
        <field name="res_model">authors</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="authors_view_form" model="ir.ui.view">
        <field name="name">authors.form</field>
        <field name="model">authors</field>
        <field name="arch" type="xml">
            <form>
            <sheet>
                <group>
                    <field name="author_name"/>
                </group>
                <group>
                    <field name="description"/>
                </group>
                <notebook>
                    <page string="authors related to books">
                       <field name="author_book_ids"/>

                    </page>
                </notebook>
            </sheet>
            </form>
        </field>
    </record>
    <record id="authors_view_list" model="ir.ui.view">
        <field name="name">authors.list</field>
        <field name="model">authors</field>
        <field name="arch" type="xml">
                <list string="'authors">
                    <field name="author_name"/>



                </list>
        </field>
    </record>
    <record id="authors_view_search" model="ir.ui.view">
        <field name="name">authors.search</field>
        <field name="model">authors</field>
        <field name="arch" type="xml">
                <search string="authors">
                    <field name="author_name"/>

                </search>
        </field>
    </record>
</odoo>