<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="publishers_action" model="ir.actions.act_window">
        <field name="name"> Publishers </field>
        <field name="res_model">publishers</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="publishers_view_form" model="ir.ui.view">
        <field name="name">publishers.form</field>
        <field name="model">publishers</field>
        <field name="arch" type="xml">
            <form>
            <sheet>
                <group>
                    <field name="publishers_name"/>
                </group>
                <group>
                    <field name="publication_year"/>
                </group>

                <group>
                    <field name="address"/>
                </group>
                <notebook>
                    <page string="publishers relation to their published books">
                       <field name="publishers_book_ids"/>
                    </page>
                </notebook>
            </sheet>
            </form>
        </field>
    </record>
    <record id="publishers_view_list" model="ir.ui.view">
        <field name="name">publishers.list</field>
        <field name="model">publishers</field>
        <field name="arch" type="xml">
                <list string="'publishers">
                    <field name="publishers_name"/>



                </list>
        </field>
    </record>
</odoo>
