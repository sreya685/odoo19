<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="form_library_report">
        <t t-call="web.html_container">
            <!--            <t t-foreach="data['report']" t-as="o">-->

            <t t-call="web.external_layout">
                <!--                <t t-foreach="data['report']" t-as="o">-->

                <h1>Checkouts</h1>
                <div class="page">
<!--                    <t t-foreach="data['report']" t-as="o">-->

                        <table>
                            <thead>
                                <th>Checkout ID</th>
                                <th>Book Name</th>
                                <th>Author Name</th>
                                <th>Checkout Date</th>
                                <th>Return Date</th>
                                <th>Genre Type</th>

                            </thead>
                            <tbody>
                                <t t-foreach="data['report']" t-as="o">
                                    <tr>
                                        <td>
                                            <span t-out="o['check']"/>
                                        </td>
                                        <td>
                                            <span t-out="o['book_name']"/>
                                        </td>
                                        <td>
                                            <span t-out="o['author_name']"/>
                                        </td>
                                        <td>
                                            <span t-out="o['checkout_date']"/>
                                        </td>
                                        <td>
                                            <span t-out="o['return_date']"/>
                                        </td>
                                        <td>
                                            <span t-out="o['genre_types']"/>
                                        </td>
                                    </tr>
                                </t>

                            </tbody>
                        </table>
<!--                    </t>-->
                </div>
            </t>
        </t>
        <!--            </t>-->


    </template>
</odoo>