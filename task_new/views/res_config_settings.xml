<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.task.new</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="90"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="Task" id="task_new" string="task_new" name="task_new" >
                        <block title="Tags" id="tags">
                            <setting string="Customer Tags">
                                <div>
                                    <span>Customer Tags</span>
                                    <field name="restricted_customer_tag_ids" widget="many2many_tags" class="text-center" style="width: 10%; min-width: 4rem;" />

                                </div>
                            </setting>
                              <setting string="credit limit threshold">
                                <div>
                                    <span>credit limit threshold</span>
                                    <field name="credit_limit_threshold"  class="text-center" style="width: 10%; min-width: 4rem;" />

                                </div>
                            </setting>


                        </block>
                    </app>
                </xpath>
            </field>
        </record>

        <record id="task_new_config_settings_action" model="ir.actions.act_window">
            <field name="name">Settings</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="context">{'module' : 'task_new', 'bin_size': False}</field>
        </record>
      </data>

</odoo>
