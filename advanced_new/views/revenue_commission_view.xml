<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
     <record id="revenue_commission_action" model="ir.actions.act_window">
        <field name="name"> Revenue Commission </field>
        <field name="res_model">revenue.commission</field>
        <field name="view_mode">list,form</field>
    </record>
     <record id="revenue_commission_view_list" model="ir.ui.view">
        <field name="name">revenue.commission.list</field>
        <field name="model">revenue.commission</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="commission_id"/>
<!--                <field name="commission"/>-->
                <field name="from_amount"/>
                <field name="to_amount"/>
                <field name="rate"/>

            </list>
        </field>
     </record>

</odoo>