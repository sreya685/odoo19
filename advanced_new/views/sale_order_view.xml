<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
      <record id="view_commission_sales" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.crm.commission</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">
                     <label for="commission_amt" string="Sale orders"/>
                    <field name="commission_amt" string="Commission Amount"/>
                </xpath>

        </field>
       </record>

</odoo>