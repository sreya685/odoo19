<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
           <record id="mrp_production_material_action" model="ir.actions.act_window">
        <field name="name"> MRP Production Material </field>
        <field name="res_model">mrp.production.material.line</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
       <record id="mrp_production_material_list" model="ir.ui.view">
        <field name="name">mrp.production.material.line.list</field>
        <field name="model">mrp.production.material.line</field>
        <field name="arch" type="xml">
             <list string="line" editable="bottom">

                        <field name="production_id"/>
                        <field name="product_id"/>
                        <field name="required_qty"/>
                        <field name="available_qty"/>
                        <field name="consumed_qty"/>
                        <field name="bom_line_qty" column_invisible="True" />
                </list>

        </field>
     </record>

</odoo>